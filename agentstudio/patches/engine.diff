+                            </span>
+                            <span className="ml-auto">
+                                <ToolReview
+                                    toolUuid={toolUuid}
+                                    revision={revision.revision}
+                                    state={revision.state}
+                                    onReviewed={load}
+                                />
+                            </span>
+                        </div>
+                    ))}
+                </div>
+            </CardContent>
+        </Card>
+    );
+}
