+    assert "fish" in REGISTRY[ServiceType.TTS]
+    for bad in ({"latency": "normal"}, {"speed": 5}, {"style": "[angry]"}, {"volume": 30},
+                {"model": "s2.1-pro"}, {"temperature": 2}, {"top_p": 0}):
+        with pytest.raises(ValidationError):
+            config(**bad)
