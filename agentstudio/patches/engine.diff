+
+    [event] = logs_buffer.get_events()
+    assert event["payload"]["timestamp"] == "2026-10-01T10:00:01.000+00:00"
+    assert event["payload"]["end_timestamp"] == "2026-10-01T10:00:03.500+00:00"
