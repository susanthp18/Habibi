+    answer = {"read_back": "matches", "reply": "agrees", **({"said_time": said} if said else {})}
+    service = ActionConfirmationService(_Llm(json.dumps(answer)))
+    turns = [("assistant", "A callback on Friday at 5 pm India time?"), ("user", "Yes, that works.")]
