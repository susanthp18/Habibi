+                <div className="space-y-2">
+                    <Label>Revision history</Label>
+                    {revisions.length === 0 && (
+                        <p className="text-sm text-muted-foreground">No revisions yet.</p>
+                    )}
+                    {revisions.map((revision) => (
+                        <div
