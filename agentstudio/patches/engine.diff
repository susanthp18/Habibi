+def summarize_realtime_feedback_tool_result(result: Any) -> dict[str, Any]:
+    """Persist only outcome metadata; tool data can contain borrower information."""
+    if not isinstance(result, dict):
+        return {"ok": None, "error_code": None}
+    data = result.get("data") if isinstance(result.get("data"), dict) else {}
+    status = result.get("status")
+    explicit_ok = data.get("ok") if isinstance(data.get("ok"), bool) else result.get("ok")
+    ok = explicit_ok if isinstance(explicit_ok, bool) else (status == "success" if status else None)
+    if status == "error":
+        ok = False
+    code = data.get("error") or result.get("error")
+    # A free-form error can contain PII. Only stable machine codes are retained.
+    if not isinstance(code, str) or not code.isascii() or not code.replace("_", "").isalnum() or len(code) > 64:
+        code = None
+    status_code = result.get("status_code")
+    return {"ok": ok, "error_code": code,
+            "http_status": status_code if isinstance(status_code, int) else None}
+
