# Copy to .env and adjust. Local dev defaults are fine for on-prem single node.
POSTGRES_USER=collections
POSTGRES_PASSWORD=collections
POSTGRES_DB=collections
POSTGRES_PORT=5432
# App connection string (SQLAlchemy / psycopg)
DATABASE_URL=postgresql+psycopg://collections:collections@localhost:5432/collections

# --- Meta / WhatsApp Cloud API (Phase B) ---
META_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_VERIFY_TOKEN=
# Last-resort utility template, used for ANY purpose whose own template var
# below is unset (PTP confirm, bounce notice, treatment nudge). Outside Meta's
# 24h service window a freeform message is undeliverable, so with no template
# resolved the send does not happen at all.
#
# The three purposes pass DIFFERENT body params — PTP (amount, date, pay URL),
# bounce (amount, due date, pay URL), treatment (name, pay URL) — so a single
# fallback only works if it is registered in WhatsApp Manager accepting the
# params of every purpose it is standing in for. Otherwise Meta rejects the
# send. Prefer the purpose-specific vars; this is the safety net.
WHATSAPP_FALLBACK_TEMPLATE_NAME=
WHATSAPP_FALLBACK_TEMPLATE_LANG=en_US
# Recipient for the WhatsApp round-trip seed fixture (E.164 digits, no +).
# seed_susanth refuses to invent one — this number receives real messages during
# testing. It has no fallback, and seed_postgres calls it unguarded, so leaving
# this empty makes `scripts/seed_demo.py` raise and takes the whole test suite
# with it. Set your own handset locally; the placeholder below is non-routable
# and is what CI uses.
WHATSAPP_TEST_TO=910000000000
# Public URL for Meta webhooks (ngrok etc.) — no trailing slash
PUBLIC_BASE_URL=

# --- PTP pay-link fulfillment ---
# hosted (default sandbox HTML page) | razorpay (stub until keys + order API)
PAYMENT_PROVIDER=hosted
# HMAC secret for POST /webhooks/payments/{provider}
PAYMENT_WEBHOOK_SECRET=
# HMAC secret for POST /webhooks/collections/payment-events (falls back to PAYMENT_WEBHOOK_SECRET)
PAYMENT_EVENTS_WEBHOOK_SECRET=
# Meta utility template for voice-originated PTP (outside the 24h window).
# Body params: amount, date, pay URL. Register in WhatsApp Manager first.
# Unset falls back to WHATSAPP_FALLBACK_TEMPLATE_NAME above.
WHATSAPP_PTP_TEMPLATE_NAME=
WHATSAPP_PTP_TEMPLATE_LANG=en_US
# Bounce notice (amount, due date, pay URL). Unset falls back to
# WHATSAPP_FALLBACK_TEMPLATE_NAME; with neither set, freeform inside the 24h
# window only.
WHATSAPP_BOUNCE_TEMPLATE_NAME=
WHATSAPP_BOUNCE_TEMPLATE_LANG=en_US
# Last-resort autodial when both WA and SMS are opted out. Default off.
BOUNCE_VOICE_ENABLED=false
# SMS fallback when WhatsApp is opted out or outside the service window.
TWILIO_SMS_FROM=

# --- Azure OpenAI (KB / Phase C) ---
# Deployment names MUST match what is provisioned in your Azure OpenAI resource
# (not fixed OpenAI model IDs — a mismatch yields Azure 404).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=
# Set true/false ONLY to override the deployment-name heuristic when your chat
# deployment is a reasoning model (o-series / GPT-5) under a non-obvious alias.
# Reasoning models reject a custom temperature and require max_completion_tokens.
AZURE_OPENAI_REASONING_MODEL=
# Same override for the voice prewarm deployment; falls back to the value above.
AZURE_OPENAI_VOICE_REASONING_MODEL=
# Voice turn loop may use a separate Azure OpenAI resource (e.g. BT-RMC gpt-4.1-mini).
# Falls back to main AZURE_OPENAI_* when unset.
AZURE_OPENAI_VOICE_ENDPOINT=
AZURE_OPENAI_VOICE_API_KEY=
AZURE_OPENAI_VOICE_API_VERSION=
AZURE_OPENAI_VOICE_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Pinned hard — kb_chunks.embedding is vector(1536); any other dim fails INSERT.
AZURE_OPENAI_EMBEDDING_DIMS=1536
# Studio prompt token/$ display (input only; cl100k_base via tiktoken)
AZURE_OPENAI_INPUT_USD_PER_1M=2.5

# --- Azure Speech (PS-4 TTS / PS-5E STT — same Speech resource) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus2
AZURE_SPEECH_TTS_VOICE_DEFAULT=en-IN-AartiNeural
# Optional override map: studio voice id → Azure neural voice name
# AZURE_SPEECH_VOICE_MAP=priya:en-IN-AartiNeural,ravi:en-IN-PrabhatNeural

# Default bot for publish / active deployment loader (single-bot PoC)
BOT_ID=kaia-v2-4

# --- WhatsApp reply bot (BR-0 / BR-1) ---
# Feature flag: webhook enqueues bot_turn_jobs only when true
BOT_RUNTIME_ENABLED=false
# Selects active bot_deployments.environment (authoritative config)
BOT_ENVIRONMENT=production
BOT_HARD_MAX_TURNS=12
BOT_MAX_TOOL_ITERATIONS=6
BOT_JOB_MAX_ATTEMPTS=5
BOT_JOB_STALE_RUNNING_SEC=300
# Agent WhatsApp sends are always queued (whatsapp_outbound_jobs); bot_worker drains them
# even when BOT_RUNTIME_ENABLED=false.
WHATSAPP_OUTBOUND_MAX_ATTEMPTS=5
WHATSAPP_OUTBOUND_STALE_RUNNING_SEC=180
# Scale path (later):
# REDIS_URL=redis://redis:6379/0
# BOT_QUEUE_BACKEND=postgres|arq

# --- MinIO (KB-2 — RAG source originals in kb_source_files) ---
# storage_ref: minio://{bucket}/kb/{doc_id}/{filename}  (no tenant segment)
# Generate UNIQUE credentials (e.g. `openssl rand -hex 24`) — do NOT reuse the
# well-known minioadmin/minioadmin defaults. docker-compose requires these set.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=collections-kb
MINIO_SECURE=false

# --- KB worker / retrieve tuning (KB-4) ---
# Embedding batch size for Azure embed_texts (1–128)
AZURE_OPENAI_EMBED_BATCH_SIZE=16
# Process-local embedding query LRU (0 disables). Multi-worker → low hit rate → Redis.
AZURE_EMBED_CACHE_MAX=256
# Re-queue index jobs stuck in running longer than this (minutes)
KB_STUCK_JOB_MINUTES=15
# Process-local rate limits
KB_RETRIEVE_MAX_PER_MIN=60
KB_INBOX_SUGGEST_MAX_PER_MIN=30

# --- KB gap capture (the learning loop) ---
# Record questions the bot could not answer into unanswered_questions, which
# feeds the KB-gap screen and the gap → FAQ / prompt-version workflow. Only
# fires on a successful retrieval that came back empty or below threshold, and
# only for real customer turns — the speculative prefetch and the operator's
# KB test panel bypass the shared handler entirely.
KB_GAP_CAPTURE_ENABLED=true
# Retrieval margin (top1 - top2) below which a question is logged as a possible
# content gap. Replaced KB_GAP_THRESHOLD, which thresholded the absolute top
# score - a signal measured at AUC 0.548 (coin flip) against 0.975 for margin.
KB_GAP_MARGIN=0.02

# --- Billing / usage metering (Azure list prices → INR) ---
# Environment label written to usage_events / billing_usage_daily
BILLING_ENV=production
USD_INR_FX=86.0
# Chat (GPT-5-mini class) — USD per 1M tokens
PRICE_CHAT_INPUT_USD_PER_1M=0.25
PRICE_CHAT_OUTPUT_USD_PER_1M=2.00
# Embeddings (text-embedding-3-small) — USD per 1M tokens
PRICE_EMBED_USD_PER_1M=0.02
# Azure Speech neural TTS — USD per 1M characters
PRICE_TTS_USD_PER_1M_CHARS=15.0
# Azure Speech standard STT — USD per hour
PRICE_STT_USD_PER_HOUR=1.0

# Tenant (non-KB screens; KB itself is global). Actor identity is under API auth.
TENANT_ID=hdfc.retail

# --- Migrations / demo seed ---
# Alembic demo INSERTs are OFF by default. Schema always runs on upgrade head.
# For local demo rows via migrations: ALEMBIC_SEED_DEMO=1 alembic upgrade head
# Preferred: python scripts/seed_demo.py (refuses APP_ENV=production|prod).
# ALEMBIC_SEED_DEMO=

# --- API auth / CORS (optimization Tier 0) ---
# APP_ENV=production|prod → API_KEY or API_KEY_MAP required at boot; OpenAPI docs disabled.
APP_ENV=dev
# Shared secret — CRM routes require X-API-Key / Bearer when set.
# WhatsApp webhooks + /health + /ready stay exempt (HMAC / probes).
API_KEY=
# Preferred multi-user keys (JSON object: secret → users.id). When set, each
# key attributes writes to that user. Example:
# API_KEY_MAP={"priya-secret":"priya-nair","rahul-secret":"rahul-sharma"}
API_KEY_MAP=
# Fallback actor when using a single shared API_KEY (or auth disabled).
ACTOR_USER_ID=priya-nair
# Allow X-Actor-User-Id to override actor with a shared API_KEY.
# Default: on in non-prod, off in production (prevents spoofing).
# ALLOW_ACTOR_HEADER=true
# Prod cookie auth: comma-separated origins (enables allow_credentials).
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Dev (unset): localhost regex + allow_credentials=True
CORS_ORIGINS=

# --- SQLAlchemy pool + statement timeout (binding concurrency ceiling) ---
# Per-process max connections = DB_POOL_SIZE + DB_MAX_OVERFLOW (default 5+10=15).
# Budget: uvicorn_workers × that + kb_worker + bot_worker + voice < max_connections − reserved.
# Do NOT raise uvicorn --workers until this budget is set. Prefer PgBouncer before replicas.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
# Milliseconds. Leave unset to use role defaults (api=15000, worker/bot/voice=60000).
# Processes set DB_PROCESS_ROLE themselves (worker/bot_worker/voice.bot); do not force api here.
# DB_STATEMENT_TIMEOUT_MS=

# --- Docker Compose app-service pool overrides (docker-compose.yml) ---
# Defaults in compose already budget ~25 conns total. Override only if you know the math:
#   API_DB_POOL_SIZE=5
#   API_DB_MAX_OVERFLOW=5
#   WORKER_DB_POOL_SIZE=3
#   WORKER_DB_MAX_OVERFLOW=2
#   BOT_WORKER_DB_POOL_SIZE=3
#   BOT_WORKER_DB_MAX_OVERFLOW=2
#   VOICE_DB_POOL_SIZE=3
#   VOICE_DB_MAX_OVERFLOW=2
# Compose remaps DATABASE_URL → @db and MINIO_ENDPOINT → minio:9000 automatically.
# Host-local .env may still say localhost for non-compose runs.

# --- Scale path reminder (do not raise uvicorn --workers blindly) ---
# total_conns ≈ workers×(DB_POOL_SIZE+DB_MAX_OVERFLOW) + kb_worker + bot_worker + voice
# Keep that under Postgres max_connections (default 100) minus reserved (~10).
# Prefer PgBouncer (transaction mode) before adding replicas.

# --- Azure OpenAI concurrency / keep-alive ---
AZURE_OPENAI_TIMEOUT_S=20
AZURE_OPENAI_MAX_CONCURRENT=6
# Seconds to wait for a semaphore slot before shedding with 503.
AZURE_OPENAI_ACQUIRE_TIMEOUT_S=10
# In-process circuit breaker (Azure / Meta / MinIO) — open after N failures for reset_s.
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT_S=60

# --- Turn understanding (LLM intent + sentiment + language) ---
# Replaces the English keyword classifier and lexicon scorer as the PRIMARY
# signal; they stay as the fallback for every failure below. Off → the keyword
# path runs alone and no Azure call is made.
#
# Matters because the STT stack is configured for hi-IN/en-IN but the keyword
# classifier only reads English: "paisa nahi hai bhai" scores out_of_scope with
# sentiment 0.00, which routes to the wrong KB corpus, fires no escalation, and
# leaves an upset caller eligible for an upsell pitch.
UNDERSTANDING_LLM_ENABLED=true
UNDERSTANDING_LLM_MAX_TOKENS=220
#
# Background-analysis Azure profile — used by turn understanding (and QA
# auto-scoring). Its own semaphore and circuit breaker so a burst of analysis
# can never delay the live speech turn or trip the circuit the conversation
# depends on. Every endpoint/key/version below falls back to the main
# AZURE_OPENAI_* value; set only AZURE_OPENAI_ANALYSIS_DEPLOYMENT to share the
# endpoint but use a cheaper model, or set all four for a separate quota.
# AZURE_OPENAI_ANALYSIS_ENDPOINT=
# AZURE_OPENAI_ANALYSIS_API_KEY=
# AZURE_OPENAI_ANALYSIS_API_VERSION=
# AZURE_OPENAI_ANALYSIS_DEPLOYMENT=
AZURE_OPENAI_ANALYSIS_MAX_CONCURRENT=2
# One second, against ten for the chat profile: every analysis caller already
# has a keyword result in hand, so waiting is strictly worse than shedding.
AZURE_OPENAI_ANALYSIS_ACQUIRE_TIMEOUT_S=1
AZURE_OPENAI_ANALYSIS_TIMEOUT_S=8

# --- QA auto-scoring ---
# Score completed BOT calls against the QA rubric and write them as `ai_draft`
# scorecards with `accepted` unset — the state the QA screen already renders as
# "needs review". A human still decides; this stops the queue being empty.
# Runs in the KB worker on a ~2 min tick, batch of 10, on the analysis profile.
# Human-handled calls are deliberately excluded.
QA_AUTOSCORE_ENABLED=false

# --- MCP tool server (optional, separate process) ---
# `python -m mcp_server` exposes the READ-ONLY tools from agent_core's catalog
# to an external agent. Never mounted on the FastAPI app: BaseHTTPMiddleware
# does not support SSE scopes, GZip would buffer the stream, and an auth
# exemption would put CRM tools on the public API. Requires
# `pip install -r requirements-mcp.txt` for stdio (SDK). HTTP uses Starlette
# only — the main venv is enough.
#
# stdio: the process boundary is the auth boundary.
# http:  MCP_HTTP_ENABLED=true, MCP_TRANSPORT=http, MCP_API_KEY required.
#        Bind 127.0.0.1. Put mTLS certs in MCP_TLS_* for anything off-box.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8081
# Required for HTTP. Bootstrap key is crm.read + kb.search + offers.read +
# policy.read only — never tasks.write, never mutators.
# MCP_API_KEY=
# MCP_TLS_CERTFILE=
# MCP_TLS_KEYFILE=
# MCP_TLS_CAFILE=

# Local vault envelope when Azure Key Vault is unset. Connector OAuth lives in
# vault_refs, not here. Rotation is an Integrations action, not a deploy.
# The only source for this key — it no longer falls back to SKILL_PLATFORM_KEY,
# which signs skill packs and has nothing to do with sealing secrets. Required
# once APP_ENV names anything other than a dev/test/local environment.
# VAULT_MASTER_KEY=dev-vault-master-key-not-for-prod
# AZURE_KEY_VAULT_URL=
# AZURE_KEY_VAULT_TOKEN=

# LiteLLM / APIM OpenAI-compatible URL. When LLM_GATEWAY_ENABLED=true this is
# the mouth path; azure_openai.chat_with_tools is the kill-switch if unset.
# LITELLM_BASE_URL=
# LITELLM_API_KEY=
# LLM_GATEWAY_URL=
# LLM_GATEWAY_KEY=
# LLM_GATEWAY_VOICE_MODEL=
# LLM_GATEWAY_TEXT_MODEL=
# LLM_GATEWAY_ANALYSIS_MODEL=
# LLM_GATEWAY_INTERNAL_MODEL=
# LLM_GATEWAY_CAP_INR=0
# LLM_GATEWAY_CAP_VOICE_INR=0

# --- Agent factory (all off until the phase that owns them) ---
# Names are locked in agent_core/platform_flags.py. Do not invent aliases.
AGENT_CARDS_ENABLED=false
MCP_HTTP_ENABLED=false
MCP_CLIENT_ENABLED=false
MCP_TASKS_ENABLED=false
MCP_APPS_ENABLED=false
A2A_ENABLED=false
EVAL_GATE_ENABLED=false
REDTEAM_GATE_ENABLED=false
LLM_GATEWAY_ENABLED=false
VISION_INGEST_ENABLED=false
TEMPORAL_ENABLED=false
POLICY_EXPORT_ENABLED=false

# HMAC-SHA256 key for first-party skill signatures. Unsigned packs cannot
# attach to a published card (compiler G9). Gardener drafts never use this.
# Rotating this key: restart the API so ensure_first_party_skills re-signs
# disk packs. Tenant drafts stay unsigned until a human signs them again.
SKILL_PLATFORM_KEY=dev-skill-platform-key-not-for-prod

# --- Voice sandbox runner ---
# Two hosting modes:
#   1. Standalone (default) — `python -m voice.bot` on :7860, API on :8000.
#      VOICE_RUNNER_URL points the API at it; Vite proxies /voice-rtc there.
#   2. Embedded — VOICE_EMBEDDED_HOST=true and the API serves the pipeline
#      itself on :8000 (/api/offer, /voice-rtc/api/offer, /ws). No second
#      process, no start order, one tunnel. Point the Vite dev proxy at the
#      API with VOICE_RTC_TARGET=http://127.0.0.1:8000.
VOICE_EMBEDDED_HOST=false
VOICE_RUNNER_URL=http://127.0.0.1:7860
VOICE_WEBRTC_PUBLIC_URL=/voice-rtc/api/offer

# --- Twilio Voice (PSTN via Media Streams) ---
# Point the Twilio number Voice webhook to:
#   POST {PUBLIC_BASE_URL}/twilio/voice/incoming   (API :8000 via ngrok)
# Default: VOICE_WS_VIA_API=true — same ngrok proxies /ws → voice:7860
# (no second tunnel). Set VOICE_WS_VIA_API=false + VOICE_PUBLIC_BASE_URL for
# a dedicated voice ngrok if you prefer.
# Start: python -m voice.bot -t twilio --host 0.0.0.0 --port 7860
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# E.164 supervisor phone for warm-transfer dial-out (Verified Caller ID on trial).
SUPERVISOR_CALLBACK_PHONE=
# callback_queue (default, Inbox takeover in Habibi) | warm (Twilio conference)
VOICE_HANDOFF_MODE=callback_queue
VOICE_WS_VIA_API=true
VOICE_PUBLIC_BASE_URL=
# Shared secret for /ws Media Stream upgrades (prod fail-closed). When set,
# TwiML Stream URL uses path wss://…/ws/{secret} — NOT ?proxy_secret= (Twilio
# Media Streams reject query strings; error 31920). Header X-Voice-Proxy-Secret
# still works for non-Twilio clients. Legacy ?proxy_secret= is accepted by the
# gate but must not appear in <Stream url>.
# VOICE_WS_PROXY_SECRET=

# --- Sandbox text tool loop + voice polish ---
# SANDBOX_TEXT_TOOLS=true
# VOICE_FILTER_INCOMPLETE_TURNS=false
# VOICE_AUDIO_BUFFER_SECS=
# VOICE_TURN_AUDIO=1

# --- IVR (telephony only; both off by default) ---
# Outbound: navigate a workplace/partner switchboard to reach a human before
# the collections script starts. Costs a classifier turn, so leave off for
# direct-to-handset campaigns. Per-call override: twilio_params.ivr_goal.
# VOICE_IVR_ENABLED=false
# Inbound: fold caller keypad digits into the transcript ("press 1", typed
# account tail) instead of dropping them.
# VOICE_DTMF_INPUT_ENABLED=false

# --- Multi-agent voice mesh ---
VOICE_MULTI_AGENT_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
# Sidecar: python -m voice.workers.insurance
# Conversation graph:
#   unset / auto — authored Prompt Studio flow when the published version has
#                  nodes, otherwise the hardcoded collections script
#   legacy       — always hardcoded (kill-switch)
#   hub          — merged collections_hub experiment
#   db           — authored only (falls back if empty / compile fails)
# VOICE_FLOW_GRAPH=auto

# --- Next-Best-Offer engine (agent_core/reco — see its README) ---
# The recommender chooses the product; the model only speaks it.
#
# shadow (default): score and log every call, present nothing. Run this for a
# couple of weeks before going live — it is the same code path, so what ships
# is what was measured. An unrecognised value degrades to shadow, never off.
RECO_MODE=shadow
# RECO_SCORER=rule
# Below this score the engine would rather say nothing than burn handle time.
# RECO_MIN_SCORE=0.35
# RECO_MAX_OFFERS=2
# RECO_MAX_PER_CALL=1
# RECO_MAX_PER_CUSTOMER_30D=3
# RECO_DECLINE_COOLDOWN_DAYS=90
# Matches sentiment_label's negative boundary.
# RECO_SENTIMENT_FLOOR=-0.15
# No product is offered before a promise-to-pay or callback is recorded.
# RECO_REQUIRE_COMMITMENT=true
# Signal weights — tuning a recommender is an operational act, not a release.
# RECO_W_AFFINITY=0.20
# RECO_W_AFFORDABILITY=0.20
# RECO_W_CREDIT=0.15
# RECO_W_INTENT=0.20
# RECO_W_SENTIMENT=0.10
# RECO_W_CAMPAIGN=0.10
# RECO_W_FATIGUE=0.05

# --- KB ANN recall/latency knob (pgvector HNSW; default was 40) ---
HNSW_EF_SEARCH=64

# KB retrieval planning / answerability (agent_core/tools/kb_plan.py)
KB_PLANNER_ENABLED=true
KB_VOICE_PLAN_BUDGET_S=2.5
KB_TEXT_PLAN_BUDGET_S=4.0
KB_PLAN_REASONING_EFFORT=low
# Customers' local time. Containers run UTC; this is what times mean to callers.
APP_TIMEZONE=Asia/Kolkata

# --- Contact policy gate (P6) ---
# Fail-closed cross-channel cap. No per-request override. Statutory PTP confirms
# still send; they count toward the cap so later outreach that day is blocked.
CONTACT_DAILY_CAP=3
CONTACT_WEEKLY_CAP=8
CONTACT_COOLING_OFF_MINUTES=120
CONTACT_SESSION_WINDOW_MINUTES=30

# --- Next-best-treatment engine (P3) ---
# Decides *what* should happen to a delinquent account and *when*: silence, SMS,
# WhatsApp, a bot call, an agent call, a field visit or a statutory notice.
# shadow (default): decide and log everything, enact nothing. Run this for a
# couple of weeks and read GET /treatment/insights before going live — it is the
# same code path, so what ships is what was measured. An unrecognised value
# degrades to shadow, never off.
TREATMENT_MODE=shadow
# TREATMENT_SCORER=ev
# Rupees of expected value below which the engine would rather wait. "Do
# nothing" scores exactly zero, so this is the margin an attempt must beat.
# TREATMENT_MIN_EV=2.0
# Fraction of exposure a successful treatment actually recovers — curing a 1-30
# DPD account means collecting the instalment, not the balance.
# TREATMENT_RECOVERY_FRACTION=0.35
# Hours over which acting later halves its value. "The profit lever is delay,
# not dialogue" is this number.
# TREATMENT_URGENCY_HALFLIFE_HOURS=36
# Rupees of goodwill one attempt spends, per unit of intrusiveness, per touch
# already spent today. What stops three cheap SMS out-earning one useful call.
# TREATMENT_FATIGUE_COST=6.0
# Escalation rungs per decision. Digital straight to a doorstep is how a
# three-day-old miss ends up with someone at the door.
# TREATMENT_MAX_RUNG_ADVANCE=1
# Hold the day's last contact slot unless the action clearly justifies it.
# TREATMENT_RESERVE_BUDGET=true
# TREATMENT_RESERVE_MARGIN=3.0
# Unanswered digital sends before a field visit becomes offerable at all.
# TREATMENT_FIELD_DIGITAL_EXHAUSTION=4
# TREATMENT_HORIZON_HOURS=72
# Unit economics, all-in rupees per attempt. Wrong on day one for every
# deployment — these are the first numbers a collections head should correct.
# TREATMENT_COST_SMS=0.18
# TREATMENT_COST_WHATSAPP=0.42
# TREATMENT_COST_VOICE_BOT=7.50
# TREATMENT_COST_HUMAN_CALL=45.0
# TREATMENT_COST_FIELD_VISIT=1150.0
# TREATMENT_COST_LEGAL_NOTICE=2500.0
# Let a model reorder the already-approved shortlist and draft one line of
# rationale. It cannot introduce an action, change a channel or a time, or put a
# figure on screen that nothing computed.
# TREATMENT_LLM_RERANK=false
# Arms: control | eager | patient | holdout. Bucketed on the customer.
# TREATMENT_AB_SPLIT=control:50,patient:50
# Template for the live-mode WhatsApp nudge outside Meta's 24h service window.
# Body params: name, pay URL. Unset falls back to
# WHATSAPP_FALLBACK_TEMPLATE_NAME; with neither set the plan is not enacted
# outside the window (NoExecutor: outside_service_window_no_template).
WHATSAPP_TREATMENT_TEMPLATE_NAME=
WHATSAPP_TREATMENT_TEMPLATE_LANG=en_US
# --- Treatment follow-through (P5) ---
# The loop that turns one decision into a ladder: attribute what each attempt
# produced, then re-decide while the case is still open. Runs in shadow too —
# labelling what happened is not an intervention.
# Attempts on one case before the ladder stops. A borrower who has ignored five
# contacts about one bounce will not be persuaded by the sixth.
# TREATMENT_MAX_ATTEMPTS_PER_CASE=5
# Minimum gap before the same case is re-decided, whatever the last attempt
# concluded. Stops a no-answer at 09:00 becoming a second dial at 09:05.
# TREATMENT_RETRY_BACKOFF_HOURS=12
# How long an attempt has before it counts as unanswered, by channel.
# TREATMENT_GRACE_DIGITAL_HOURS=8
# TREATMENT_GRACE_VOICE_HOURS=2
# TREATMENT_GRACE_HUMAN_HOURS=24
# TREATMENT_GRACE_FIELD_HOURS=48

# --- Live authority matrix (P4) ---
# What may close on this call, in rupees. The model does not choose the number.
# shadow (default): decide and log; humans see the allowed move; nothing posts.
# live: in-policy goodwill may post via POST /authority/apply or apply_goodwill.
# An unrecognised value degrades to shadow, never off.
AUTHORITY_MODE=shadow
# AUTHORITY_LATE_FEE_CAP=500
# AUTHORITY_LATE_FEE_MID_CAP=250
# AUTHORITY_LATE_FEE_MAX_OUTSTANDING=100000
# AUTHORITY_LATE_FEE_MAX_DPD=61
# AUTHORITY_MIN_TENURE_MONTHS=6

# --- Live QA (P7) ---
# Scoring is always on (deterministic FPC → scorecard). This flag only gates
# whether a critical finding auto-takes the live Twilio call.
# shadow (default): Floor shows "Would barge"; supervisor still clicks.
# live: hours / third-party / identity-leak / authority-cap / abuse auto-barge.
# An unrecognised value degrades to shadow, never off.
LIVE_QA_BARGE_MODE=shadow


# --- Cartesia TTS (provider registry: kind=tts) ---
# Pooled API keys, comma-separated. Rotation is per SESSION so one call's audio
# never spans two accounts mid-sentence; a 429 retires that key for the process.
# Free-tier keys are expected to be pooled; a paid key can be listed alone.
CARTESIA_API_KEYS=
CARTESIA_MODEL=sonic-3.5
# round_robin | least_used | sticky_per_tenant
CARTESIA_POOL_STRATEGY=round_robin

# --- Deepgram (provider registry: kind=stt + kind=tts) ---
# One key serves both Nova-3 STT and Aura-2 TTS. Comma-separated pool.
DEEPGRAM_API_KEYS=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_POOL_STRATEGY=round_robin

# --- Groq (provider registry: kind=stt) ---
# Whisper large-v3 turbo. Rate-limited rather than credit-limited.
GROQ_API_KEYS=
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- ElevenLabs (provider registry: kind=tts) ---
ELEVENLABS_API_KEYS=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# --- OpenRouter (provider registry: kind=tts) ---
# Fish Audio S2.1 Pro via the OpenAI-compatible /v1/audio/speech surface.
# Only OpenAI-standard fields pass through: speed, temperature, top_p,
# repetition_penalty, response_format. Fish-native prosody/X-Fish-* do not.
OPENROUTER_API_KEYS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free

# --- Fish Audio (direct API — provider registry: kind=tts) ---
# Distinct from OPENROUTER_*: the direct API adds the voice library (GET /model),
# real prosody/latency controls and [bracket] emotion markers that the
# OpenRouter passthrough silently drops.
FISH_API_KEYS=
FISH_BASE_URL=https://api.fish.audio
# The model is chosen by a `model:` HEADER, and the free tier is a *separate
# model id* rather than a discount on the paid one — so a valid key with a
# funded platform wallet still 402s on "s2.1-pro", because API credit is a
# different balance. Verified on one key: s2.1-pro -> 402, s2.1-pro-free -> 200.
#
# The free model is not stripped down: PCM at a requested sample_rate, the voice
# library, [bracket] emotion markers and real prosody all work (speed 0.5 vs 2.0
# measured a 4.1x duration ratio).
#
# Free through 2026-08-31 under fair use, no SLA, and requests may be used to
# improve the model — fine for a demo, revisit before production. After that
# date set this to "s2.1-pro" and fund API credit at fish.audio/app/developers.
FISH_TTS_MODEL=s2.1-pro-free

# --- Outbound agent engine (O0–O6) -------------------------------------------
# Every dial leaves a row in call_attempts whether or not anybody answers, so
# answer rate, right-party rate and cost per connect become queries. That part
# has no switch: it is bookkeeping, and turning it off would only make the
# product unable to describe itself again.
#
# These are the switches for the parts that *act*.
#
# None of them is the master switch. That one is not an environment variable at
# all: `platform_switches.outbound.enabled` is a Postgres row, off by default,
# read by all four processes and enforced inside
# `voice.twilio_ops.start_outbound_call`. It lives in the database precisely
# because everything below needs a file edit and four restarts to change, and an
# operator stopping a misbehaving campaign has neither. Flip it from Roles &
# access. The flags below are necessary but no longer sufficient.

# The cadence executor and the campaign runner. Off means nothing dials on a
# timer — the treatment engine's own executor is still gated by TREATMENT_MODE.
CAMPAIGN_RUNTIME_ENABLED=false

# Who the Roles & access "Demo outbound" button calls. A constant, not a request
# parameter: that button exists so a rehearsed demo is one click, and an endpoint
# taking an arbitrary number would be a dialer rather than a demo. There must be
# a customer on file whose phone_primary matches, or the button reports that
# instead of dialling. Ad-hoc dialling lives at POST /twilio/voice/outbound.
DEMO_OUTBOUND_PHONE=919655282324

# Block an outbound card from publishing without a passing outbound eval suite.
# Off by default like every other gate flag; turning it on is what makes
# "nobody asked to be called" an enforced property rather than an intention.
OUTBOUND_EVAL_GATE_ENABLED=false

# How many of our own dials may be alive at once. Default 10 against
# voice/admission.py's per-process cap of 25 — outbound must leave headroom for
# inbound, because an inbound caller who is refused dialled us on purpose.
OUTBOUND_MAX_IN_FLIGHT=10

# An in-flight attempt whose carrier callback never arrived is reaped after
# this long. It would otherwise hold a slot in the fleet gate forever.
OUTBOUND_STALE_MINUTES=30

# Ask the carrier for an answering-machine verdict as a second signal alongside
# Pipecat's in-band detector. Off: it delays connect on every dial to buy a
# signal we mostly already have.
OUTBOUND_CARRIER_AMD=false

# Country code assumed for a stored 10-digit number. customers.phone_primary
# holds bare digits because that is what the WhatsApp Graph API wants; Twilio
# rejects the same value as error 21211.
OUTBOUND_DEFAULT_COUNTRY_CODE=91

# How long after a call ends before the Closer writes its outcome. CrmSink
# drains the transcript asynchronously, so closing immediately would summarise a
# conversation missing its last few turns — just as confidently.
CLOSER_GRACE_SECONDS=45

# LLM enrichment on top of the deterministic outcome. Off still leaves a
# complete, valid row: every field the model fills has a deterministic fallback.
CLOSER_LLM_ENABLED=true

# Ceiling on a single cadence wait, whatever the card asks for. A 30-day backoff
# is not a cadence, it is a case somebody forgot about.
CADENCE_MAX_BACKOFF_HOURS=168
