# Habibi frontend env — copy to .env.local
#
# The CRM API the browser talks to. `backend/scripts/run_stack.ps1` brings the
# stack up on this port; there is no offline mode.
VITE_API_BASE_URL=http://localhost:8000
# Vite inlines every VITE_* value into the client bundle — never put a shared
# backend secret here. Prefer API_KEY_MAP / server-side auth; if you set this,
# treat it as a browser-visible demo key only.
# VITE_API_KEY=
# Optional acting users.id (X-Actor-User-Id). Prefer API_KEY_MAP on the server in prod.
# VITE_ACTOR_USER_ID=priya-nair

# Optional: dress the shell for a specific demo tenant.
# Defaults to a neutral demo tenant when unset.
VITE_TENANT_LINE=

# Microsoft Entra SSO (operator login). Leave blank until the app registration exists.
# VITE_ENTRA_CLIENT_ID=f0b0dd36-d9b6-498c-a64b-b65c9f0c362b
# VITE_ENTRA_TENANT_ID=9f2e2b7d-6081-4b3a-b7f5-433b581f6a5f
# VITE_ENTRA_API_SCOPE=api://8b5d91de-0bc3-4763-9bcd-809f42f9f003/access_as_user
