# Habibi frontend env — copy to .env.local
#
# Dev (default): mock data on. Set VITE_USE_MOCK=false to hit the CRM API.
VITE_USE_MOCK=true
VITE_API_BASE_URL=http://localhost:8000
# Must match backend API_KEY when that is set
# VITE_API_KEY=
# Optional acting users.id (X-Actor-User-Id). Prefer API_KEY_MAP on the server in prod.
# VITE_ACTOR_USER_ID=priya-nair
