# CloudUnity host-port overlay for beeonixpayint.bigtapp.net
#
# Does not change laptop defaults. Pass this file to compose:
#   cd backend
#   docker compose --env-file ../deploy/cloudunity/compose.env -f docker-compose.yml up -d
#
# Every published port binds 127.0.0.1 on a slot that was free on cloudunity
# (2026-09-15). Do not change API_BIND to 0.0.0.0 on this shared VM.

API_BIND=127.0.0.1
API_PORT=8100
VOICE_PORT=7860
POSTGRES_PORT=5440
MINIO_API_PORT=9102
MINIO_CONSOLE_PORT=9103

# Public origin nginx terminates. Twilio / Meta replace ngrok with this.
PUBLIC_BASE_URL=https://beeonixpayint.bigtapp.net
VOICE_WS_VIA_API=true
HABIBI_DEPLOYED=1

# Statutory rule sets (Compliance -> Statutory rules). Publication is
# maker-checker: a different approver publishes what one person submitted.
POLICY_PRODUCTION_PUBLICATION=true
# Break-glass: these users may approve their own submission, with a written
# reason, recorded on the audit chain as a self-approval. Keep it short.
POLICY_SELF_APPROVE_USERS=susanth.p@bigtapp.ai

# Operator invites (Office365 SMTP). Values live in backend/.env, not here.
# SMTP_ENABLED=true
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_FROM_NAME=PayInt

# PayInt Voice Studio (backend/docker-compose.agentstudio.yml). Its secrets
# (AGENTSTUDIO_INTERNAL_SECRET, VOICE_STUDIO_HOOK_TOKEN, AGENTSTUDIO_JWT_SECRET,
# AGENTSTUDIO_TURN_SECRET, AGENTSTUDIO_TELEPHONY_WS_SECRET,
# AGENTSTUDIO_DB_PASSWORD, AGENTSTUDIO_REDIS_PASSWORD) live in backend/.env;
# voice-studio-rollout.sh generates any that are missing.
AGENTSTUDIO_PORT=8200
AGENTSTUDIO_PUBLIC_URL=https://beeonixpayint.bigtapp.net
AGENTSTUDIO_MEDIA_PUBLIC_URL=https://beeonixpayint.bigtapp.net
# TURN for browser test calls: 3478 tcp+udp, opened in NSG cloudunity-nsg.
AGENTSTUDIO_TURN_BIND=0.0.0.0
AGENTSTUDIO_TURN_HOST=20.205.178.161
