# Habibi production build on CloudUnity.
# Copy to Habibi/.env.production (gitignored) AND Habibi/.env.
# `vite preview` / production builds load .env.production.
# `vite dev` (this VM's payint_ui) ignores .env.production and only loads .env.
#
# Browser calls go to the same host; nginx strips /api/ onto the FastAPI
# loopback port. Do not point this at another vhost on the VM.

VITE_API_BASE_URL=https://beeonixpayint.bigtapp.net/api

# Entra — fill after the app registration exists. Leave blank until then.
# VITE_ENTRA_CLIENT_ID=
# VITE_ENTRA_TENANT_ID=
# VITE_ENTRA_API_SCOPE=api://<api-client-id>/access_as_user
